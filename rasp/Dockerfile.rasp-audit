# Dockerfile for RASP Audit Runner
FROM python:3.11-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install Python dependencies
COPY requirements.rasp.txt .
RUN pip install --no-cache-dir -r requirements.rasp.txt

# Copy audit script
COPY rasp/scripts/rasp_audit.py ./rasp_audit.py

# Create non-root user
RUN useradd -m -u 1000 appuser && chown -R appuser:appuser /app
USER appuser

# Default command runs audit once
ENTRYPOINT ["python", "rasp_audit.py"]
CMD ["--help"]
# Dockerfile for Python Flask App with RASP Middleware
FROM python:3.11-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install Python dependencies
COPY requirements.rasp.txt .
RUN pip install --no-cache-dir -r requirements.rasp.txt

# Copy application
COPY rasp/examples/flask_rasp_middleware.py ./app.py
COPY rasp/config/openrasp-python.yaml ./config.yaml

# Create non-root user
RUN useradd -m -u 1000 appuser && chown -R appuser:appuser /app
USER appuser

# Expose ports
EXPOSE 5000 8081

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD curl -f http://localhost:8081/rasp/health || exit 1

# Run application
CMD ["python", "app.py"]